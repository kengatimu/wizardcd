<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>

<configuration scan="true">
    <!-- Custom color highlighting -->
    <conversionRule conversionWord="myCustomHighlighting"
                    class="com.ebb.wizardcd.runner.config.formatter.CustomLogColorHighlighter" />

    <!-- Custom thread name processor -->
    <conversionRule conversionWord="cleanThread"
                    class="com.ebb.wizardcd.runner.config.formatter.CleanThreadConverter" />

    <!-- Console appender -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>false</withJansi>
        <encoder>
<!--            <pattern>[%d{yyyy-MM-dd'T'HH:mm:ss.SSS}] [%myCustomHighlighting(%-5level)] %magenta([%cleanThread]) [%blue(%logger{50})] %msg%n</pattern>-->
            <pattern>[%d{yyyy-MM-dd'T'HH:mm:ss.SSS}] [%myCustomHighlighting(%-5level)] [%blue(%logger{0})] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Derive log path from spring.application.name + logging.file.path -->
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="app"/>
    <springProperty name="LOG_DIR" source="logging.file.path" defaultValue="./logs"/>

    <!-- File appender with daily rolling + 30-day retention -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
<!--        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">-->
<!--            <fileNamePattern>${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>-->
<!--            <maxHistory>30</maxHistory>-->
<!--            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">-->
<!--                <maxFileSize>100MB</maxFileSize>-->
<!--            </timeBasedFileNamingAndTriggeringPolicy>-->
<!--        </rollingPolicy>-->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>[%d{yyyy-MM-dd'T'HH:mm:ss.SSS}] [%-5level] [%logger{0}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Clean console appender for deploy.sh output — no class name, just the message -->
    <appender name="DEPLOY_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>false</withJansi>
        <encoder>
            <pattern>[%d{yyyy-MM-dd'T'HH:mm:ss.SSS}] [%myCustomHighlighting(%-5level)] [deploy] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Deploy script output — clean console format, shared file appender -->
    <logger name="wizardcd.deploy" level="INFO" additivity="false">
        <appender-ref ref="DEPLOY_STDOUT"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Individual logger levels -->
    <logger name="org.hibernate.persister.entity.AbstractEntityPersister" level="INFO"/>
    <logger name="org.hibernate" level="INFO"/>
    <logger name="angus.activation" level="INFO"/>
    <logger name="jakarta.activation" level="INFO"/>
    <logger name="jakarta.mail" level="INFO"/>
    <logger name="jakarta.management.remote" level="INFO"/>
    <logger name="jakarta.xml.bind" level="INFO"/>
    <logger name="jdk.event.security" level="INFO"/>
    <logger name="com.ryantenberg" level="INFO"/>
    <logger name="com.sun" level="INFO"/>
    <logger name="com.zaxxer" level="INFO"/>
    <logger name="io.undertow" level="INFO"/>
    <logger name="io.undertow.websockets.jsr" level="ERROR"/>
    <logger name="org.apache" level="INFO"/>
    <logger name="org.apache.catalina.startup.DigesterFactory" level="OFF"/>
    <logger name="org.bson" level="INFO"/>
    <logger name="org.hibernate.validator" level="INFO"/>
    <logger name="org.hibernate.ejb.HibernatePersistence" level="OFF"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.springframework.boot.autoconfigure.logging" level="INFO"/>
    <logger name="org.springframework.cache" level="INFO"/>
    <logger name="org.thymeleaf" level="INFO"/>
    <logger name="org.xnio" level="INFO"/>
    <logger name="io.swagger.v3" level="INFO"/>
    <logger name="sun.rmi" level="INFO"/>
    <logger name="sun.rmi.transport" level="INFO"/>
    <logger name="Validator" level="INFO"/>
    <logger name="_org.springframework.web.servlet.HandlerMapping.Mappings" level="INFO"/>
    <logger name="com.equitybank.gag.papss.ots" level="INFO"/>
    <logger name="Q2.system" level="INFO"/>
    <logger name="papss-credit-transfer-tm-1" level="INFO"/>
    <logger name="papss-credit-transfer-tm-2" level="INFO"/>
    <logger name="org.jpos" level="INFO"/>

    <!-- Spring property listener -->
    <springProperty name="log.level" source="logging.level.root" defaultValue="INFO"/>
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>
</configuration>
